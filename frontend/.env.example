# Copy to frontend/.env (ignored by git), fill in, then restart Expo with -c.
# Every EXPO_PUBLIC_* value is compiled into the app bundle: never put a secret here.

# Backend origin only (no path), e.g. https://<name>.trycloudflare.com or http://<computer-ip>:8000
EXPO_PUBLIC_API_URL=
# Optional shared app token, the same value as APP_TOKEN on the backend; empty sends none. A deterrent, not authentication.
EXPO_PUBLIC_APP_TOKEN=
# Supabase project origin, e.g. https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_URL=
# Supabase publishable key, e.g. sb_publishable_<...>; never the secret key (sb_secret_<...>)
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
