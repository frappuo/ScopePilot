GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_FALLBACK_MODELS=
GEMINI_TIMEOUT_SECONDS=60
MAX_IMAGE_BYTES=10485760
MAX_IMAGE_PIXELS=20000000
# Re-encoded image bytes sent to Gemini (default 14 MiB, under Gemini's ~20 MB inline limit once base64-encoded).
MAX_ENCODED_IMAGE_BYTES=14680064
MAX_JSON_BODY_BYTES=65536
GEMINI_DAILY_CALL_LIMIT=100
APP_TOKEN=
# Legacy /analyze, /ask and /quiz. false answers them with 410 (set only after the /v1 app build ships).
LEGACY_API_ENABLED=true
# Student logbook (Supabase). Leave SUPABASE_URL empty to keep the logbook off.
# SUPABASE_SECRET_KEY bypasses row-level security: set it only on the backend host.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
LOGBOOK_BUCKET=experiment-images
USER_DAILY_GEMINI_LIMIT=40
MAX_SAVED_EXPERIMENTS_PER_USER=50
MAX_DRAFTS_PER_USER=10
DRAFT_TTL_HOURS=24
# RAG reference passages. Changing the model means re-running ingestion (python -m rag.ingest).
RAG_EMBEDDING_MODEL=gemini-embedding-2
# true adds reference passages to experiment questions; false (default) keeps them out entirely.
RAG_ENABLED=false
RAG_TOP_K=4
# Provisional threshold (cosine similarity, 0-1).
RAG_MIN_SIMILARITY=0.70
# Seconds for the query embedding and the passage lookup together; on timeout the ask goes on without passages.
RAG_RETRIEVAL_TIMEOUT_SECONDS=3.0
