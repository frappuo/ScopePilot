GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_FALLBACK_MODELS=
GEMINI_TIMEOUT_SECONDS=60
MAX_IMAGE_BYTES=10485760
MAX_IMAGE_PIXELS=20000000
MAX_JSON_BODY_BYTES=65536
GEMINI_DAILY_CALL_LIMIT=100
APP_TOKEN=
# Student logbook (Supabase). Leave SUPABASE_URL empty to keep the logbook off.
# SUPABASE_SECRET_KEY bypasses row-level security: set it only on the backend host.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
LOGBOOK_BUCKET=experiment-images
USER_DAILY_GEMINI_LIMIT=20
MAX_SAVED_EXPERIMENTS_PER_USER=50
MAX_DRAFTS_PER_USER=10
DRAFT_TTL_HOURS=24
